import funkin.play.song.Song;
import funkin.play.PlayState;
import flixel.tweens.FlxTween;
import flixel.util.FlxColor;
import funkin.play.character.CharacterType;
import flixel.FlxSprite;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxEase;
import flixel.util.FlxTimer;
import flixel.FlxG;
import openfl.display.BlendMode;
import flixel.text.FlxText;
import funkin.Paths;
import funkin.play.PauseSubState;

class GoGoGoSong extends Song
{
  var introFadeDuration:Float = 6.8;
  var hasHiddenStrums:Bool;
  var coverScreen:FunkinSprite;

  var horsePNG:FunkinSprite;

  var collabLogo:FunkinSprite;
  var cg5Logo:FunkinSprite;

  var rewiredLogoStartScale:Float = 2.0;
  var rewiredLogoEndScale:Float = 0.88;
  var rewiredLogoShrinkDuration:Float = 2.0;

  var rewiredLogoTargetX:Float = -175;
  var rewiredLogoMoveDuration:Float = 2.2;

  var collabLogoX:Float = 695;
  var collabLogoY:Float = 325;
  var collabLogoFadeInDuration:Float = 0.4;

  var cg5LogoStartX:Float = 800;
  var cg5LogoEndX:Float = 865;
  var cg5LogoY:Float = 230;
  var cg5LogoMoveDuration:Float = 2.5;
  var cg5LogoFadeInDuration:Float = 1.6;

  var collabDelay:Float = 0.9;
  var cg5LogoAppearDelay:Float = 0.9;
  var outroHoldDuration:Float = 0.4;

  var outroFallFadeDuration:Float = 2.5;
  var outroTotalDuration:Float = 8.8;

  var outroTimer:FlxTimer;
  var logoFallTimer:FlxTimer;
  var outroFlashSpr:FunkinSprite;

  var hasDoneOutro:Bool;
  var curBeat:Int = 0;
  var introGhostTapEndBeat:Int = 16;

  var pauseCreditCategory:String = 'Arrangement';
  var pauseMetadataRowHeight:Float = 32;
  var isPauseCreditHooked:Bool = false;

  public function new()
  {
    super('go-go-go');
  }

  override function onCreate(e)
  {
    super.onCreate(e);
    if (PlayState.instance == null || PlayState.instance.currentStage == null) return;

    hasHiddenStrums = false;
    hasDoneOutro = false;
    curBeat = 0;
  }

  override function onSongLoaded(event)
  {
    super.onSongLoaded(event);

    var gf = PlayState.instance.currentStage?.getGirlfriend();
    if (gf != null) gf.visible = false;

    if (PlayState.instance.isChartingMode) return;

    PlayState.instance.camGame.fade(FlxColor.BLACK, 0, false, null, true);
  }

  override function onSongStart(event)
  {
    super.onSongStart(event);

    if (PlayState.instance.isChartingMode) return;

    PlayState.instance.camGame.fade(FlxColor.BLACK, introFadeDuration, true, null, true);
  }

  override function onUpdate(event)
  {
    super.onUpdate(event);
    if (!this.hasHiddenStrums)
    {
      this.hasHiddenStrums = true;
      hideOpponentStrumline();
    }
  }

  function hideOpponentStrumline()
  {
    var opponentStrumline:FlxSprite = PlayState.instance.opponentStrumline;
    if (opponentStrumline != null)
    {
      for (arrow in opponentStrumline.members)
      {
        arrow.visible = false;
      }
    }
  }

  override function onSongRetry(event)
  {
    super.onSongRetry(event);

    hasDoneOutro = false;
    curBeat = 0;

    if (outroTimer != null)
    {
      outroTimer.cancel();
      outroTimer = null;
    }

    if (logoFallTimer != null)
    {
      logoFallTimer.cancel();
      logoFallTimer = null;
    }

    if (horsePNG != null)
    {
      FlxTween.cancelTweensOf(horsePNG);
      horsePNG.visible = false;
    }

    if (collabLogo != null)
    {
      FlxTween.cancelTweensOf(collabLogo);
      collabLogo.visible = false;
    }

    if (cg5Logo != null)
    {
      FlxTween.cancelTweensOf(cg5Logo);
      cg5Logo.visible = false;
    }

    if (coverScreen != null)
    {
      coverScreen.visible = false;
    }

    if (outroFlashSpr != null)
    {
      FlxTween.cancelTweensOf(outroFlashSpr);
      outroFlashSpr.visible = false;
    }

    PlayState.instance.camHUD.visible = true;
    PlayState.instance.isInCutscene = false;
    PlayState.instance.mayPauseGame = true;
    PlayState.instance.togglePauseButton(true);

    var gf = PlayState.instance.currentStage?.getGirlfriend();
    if (gf != null) gf.visible = false;

    var stage:Dynamic = PlayState.instance.currentStage;
    if (stage?.id == 'recordingStudio')
    {
      stage.disableDarkness();
      stage.setLightHueInstant(0, 0);
      stage.disableBlackScreen();
      stage.stopOutroBuildup();
    }
  }

  override function onPause(event)
  {
    super.onPause(event);

    if (event.eventCanceled || isPauseCreditHooked || PlayState.instance == null) return;
    if (getPauseCreditee(pauseCreditCategory) == null) return;

    isPauseCreditHooked = true;
    PlayState.instance.subStateOpened.addOnce(function(subState) {
      isPauseCreditHooked = false;
      if (Std.isOfType(subState, PauseSubState)) addPauseCredit(subState);
    });
  }

  function getPauseCreditee(category:String):String
  {
    switch (category)
    {
      case 'Arrangement':
        return 'CheeseWithCake';
      default:
        return null;
    }
  }

  function addPauseCredit(pauseState)
  {
    var creditee:String = getPauseCreditee(pauseCreditCategory);
    if (creditee == null) return;

    var metadata = pauseState.metadata;
    var artist = pauseState.metadataArtist;
    var artistIndex:Int = metadata.members.indexOf(artist);
    if (artistIndex < 0 || artistIndex + 1 >= metadata.members.length) return;

    var difficulty = metadata.members[artistIndex + 1];
    var rowHeight:Float = pauseMetadataRowHeight;
    var isBottomAnchored:Bool = metadata.members[0].y > pauseState.camera.height * 0.5;

    if (isBottomAnchored)
    {
      for (i in 0...artistIndex)
      {
        metadata.members[i].y -= rowHeight;
      }
    }
    else
    {
      artist.y += rowHeight;
      difficulty.y += rowHeight;
      pauseState.metadataDeaths.y += rowHeight;
      pauseState.metadataPractice.y += rowHeight;
    }

    var creditText:FlxText = new FlxText(artist.x, artist.y - rowHeight, artist.fieldWidth, pauseCreditCategory + ': ' + creditee);
    creditText.setFormat(Paths.font('vcr.ttf'), artist.size, FlxColor.WHITE, artist.alignment);
    creditText.scrollFactor.set(0, 0);
    creditText.alpha = 0;
    metadata.insert(artistIndex, creditText);

    if (!isBottomAnchored)
    {
      var firstIndex:Int = artistIndex;
      var lastIndex:Int = metadata.members.length;
      for (i in firstIndex...lastIndex)
      {
        var child = metadata.members[i];
        FlxTween.cancelTweensOf(child, ['y']);
        FlxTween.tween(child, {alpha: 1, y: child.y + 5}, 1.8, {ease: FlxEase.quartOut, startDelay: 0.1 * (i + 1)});
      }
    }
  }

  override function onBeatHit(event)
  {
    super.onBeatHit(event);
    curBeat = event.beat;

    var gf = PlayState.instance.currentStage?.getGirlfriend();
    if (gf != null)
    {
      var shouldBeVisible:Bool = (event.beat >= 111);
      if (gf.visible != shouldBeVisible)
      {
        gf.visible = shouldBeVisible;
      }
    }

    var stage:Dynamic = PlayState.instance.currentStage;

    if (stage?.id != 'recordingStudio') return;

    // erm... actually :nerd:
    // stage.enableDarkness()
    // stage.disableDarkness()
    // stage.setLightHueLinear(hue, sec)
    // stage.setLightHueInstant(hue, sec)
    // stage.enableBlackScreen()
    // stage.disableBlackScreen()
    // stage.whiteFlash(sec)

    switch (event.beat)
    {
      case 0:
        stage.enableDarkness();
      case 7:
        stage.setLightHueInstant(0, 2.0);
      case 15:
        stage.enableBlackScreen();
      case 16:
        stage.disableDarkness();
        stage.disableBlackScreen();
        stage.whiteFlash(6.0);
      case 111:
        stage.enableBlackScreen();
        stage.enableDarkness();
      case 112:
        stage.setLightHueInstant(75, 1.5);
        stage.disableBlackScreen();
        stage.whiteFlash(6.0);
      case 127:
        stage.setLightHueInstant(-180, 1.5);
      case 129:
        stage.setLightHueInstant(-130, 1.5);
      case 131:
        stage.setLightHueInstant(-80, 1.5);
      case 133:
        stage.setLightHueInstant(-30, 1.5);
      case 135:
        stage.setLightHueInstant(20, 1.5);
      case 137:
        stage.setLightHueInstant(70, 1.5);
      case 139:
        stage.setLightHueInstant(120, 1.5);
      case 141:
        stage.setLightHueInstant(170, 1.5);
      case 144:
        stage.setLightHueInstant(75, 1.5);
        if (gf != null) gf.setIdleState('idleCool');
      case 160:
        stage.setLightHueInstant(100, 2.0);
        stage.setLightHueLinear(0, 6.0);
      case 174:
        stage.setLightHueInstant(0, 1.5);
      case 175:
        stage.enableBlackScreen();
        if (gf != null) gf.setIdleState('default');
      case 176:
        stage.disableDarkness();
        stage.disableBlackScreen();
        stage.whiteFlash(6.0);
      case 192:
        if (gf != null) gf.setIdleState('idleCool');
      case 211:
        if (gf != null) gf.setIdleState('dance2');
      case 221:
        if (gf != null) gf.setIdleState('danceCool1');
      case 239:
        stage.enableBlackScreen();
        stage.enableDarkness();
      case 240:
        if (gf != null) gf.setIdleState('danceCool2');
        stage.disableBlackScreen();
        stage.whiteFlash(6.0);
      case 242:
        stage.setLightHueInstant(120, 1.5);
      case 246:
        stage.setLightHueInstant(100, 1.5);
      case 250:
        stage.setLightHueInstant(80, 1.5);
      case 254:
        stage.setLightHueInstant(120, 1.5);
      case 258:
        stage.setLightHueInstant(80, 1.5);
      case 262:
        if (gf != null) gf.setIdleState('dance2');
        stage.setLightHueInstant(70, 1.5);
      case 266:
        stage.setLightHueInstant(120, 1.5);
        stage.setLightHueLinear(0, 3.0);
      case 272:
        stage.setLightHueInstant(0, 1.5);
        stage.disableDarkness();
        stage.whiteFlash(6.0);
      case 300:
        stage.startOutroBuildup(2.5);
    }
  }

  override function onNoteGhostMiss(event)
  {
    super.onNoteGhostMiss(event);

    if (curBeat <= introGhostTapEndBeat)
    {
      event.cancel();
      event.stopPropagation();
    }
  }

  override function onSongEnd(event)
  {
    super.onSongEnd(event);

    if (!hasDoneOutro)
    {
      event.cancel();
      event.stopPropagation();
      hasDoneOutro = true;
      doOutro();
    }
  }

  public function doOutro()
  {
    var horseChance:Bool = FlxG.random.bool(5);

    var stage:Dynamic = PlayState.instance.currentStage;
    if (stage != null && stage.id == 'recordingStudio')
    {
      stage.stopOutroBuildup();
    }

    PlayState.instance.camHUD.visible = false;
    PlayState.instance.isInCutscene = true;
    PlayState.instance.mayPauseGame = false;
    PlayState.instance.togglePauseButton();

    var cutsceneCam = PlayState.instance.camCutscene;

    if (cutsceneCam.width != FlxG.width || cutsceneCam.height != FlxG.height)
    {
      trace('[go-go-go] camCutscene (' + cutsceneCam.width + 'x' + cutsceneCam.height + ') no coincide con FlxG (' + FlxG.width + 'x' + FlxG.height
        + '), se resincroniza.');
      cutsceneCam.setSize(FlxG.width, FlxG.height);
    }

    var offsetX:Float = (FlxG.width - 1280) / 2;
    var offsetY:Float = (FlxG.height - 720) / 2;
    var centerX:Float = FlxG.width / 2;
    var centerY:Float = FlxG.height / 2;

    coverScreen = new FunkinSprite().makeSolidColor(Std.int(cutsceneCam.width * 1.5), Std.int(cutsceneCam.height * 1.5), FlxColor.BLACK);
    coverScreen.cameras = [PlayState.instance.camCutscene];
    coverScreen.zIndex = 99999;
    coverScreen.setPosition(centerX - coverScreen.width / 2, centerY - coverScreen.height / 2);

    PlayState.instance.add(coverScreen);

    //if you rename this variable you go to hell <--- "horsePNG is love, horsePNG os life" <--- really got that eric soul
    horsePNG = new FunkinSprite().loadTexture(horseChance ? 'recordingStudio/endSequence/placeholder' : 'recordingStudio/endSequence/rewiredLogo');
    horsePNG.cameras = [PlayState.instance.camCutscene];
    horsePNG.zIndex = coverScreen.zIndex + 1;
    horsePNG.scale.set(rewiredLogoStartScale, rewiredLogoStartScale);
    horsePNG.updateHitbox();
    horsePNG.setPosition(centerX - horsePNG.width / 2, centerY - horsePNG.height / 2);
    PlayState.instance.add(horsePNG);

    collabLogo = new FunkinSprite().loadTexture('recordingStudio/endSequence/collab');
    collabLogo.cameras = [PlayState.instance.camCutscene];
    collabLogo.zIndex = horsePNG.zIndex + 1;
    collabLogo.scale.set(rewiredLogoEndScale, rewiredLogoEndScale);
    collabLogo.updateHitbox();
    collabLogo.setPosition(collabLogoX + offsetX, collabLogoY + offsetY);
    collabLogo.alpha = 0;
    PlayState.instance.add(collabLogo);

    cg5Logo = new FunkinSprite().loadTexture('recordingStudio/endSequence/CG5Logo');
    cg5Logo.cameras = [PlayState.instance.camCutscene];
    cg5Logo.zIndex = collabLogo.zIndex + 1;
    cg5Logo.scale.set(rewiredLogoEndScale, rewiredLogoEndScale);
    cg5Logo.updateHitbox();
    cg5Logo.setPosition(cg5LogoStartX + offsetX, cg5LogoY + offsetY);
    cg5Logo.alpha = 0;
    PlayState.instance.add(cg5Logo);

    outroFlashSpr = new FunkinSprite().makeSolidColor(Std.int(cutsceneCam.width * 1.5), Std.int(cutsceneCam.height * 1.5), FlxColor.WHITE);
    outroFlashSpr.cameras = [PlayState.instance.camCutscene];
    outroFlashSpr.zIndex = horsePNG.zIndex + 1;
    outroFlashSpr.alpha = 0.115;
    outroFlashSpr.setPosition(centerX - outroFlashSpr.width / 2, centerY - outroFlashSpr.height / 2);
    PlayState.instance.add(outroFlashSpr);

    FlxTween.tween(outroFlashSpr, {alpha: 0}, 2.0,
      {
        onComplete: function(_) {
          if (outroFlashSpr != null)
          {
            PlayState.instance.remove(outroFlashSpr);
            outroFlashSpr.destroy();
            outroFlashSpr = null;
          }
        }
      });

    FlxTween.tween(horsePNG.scale, {x: rewiredLogoEndScale, y: rewiredLogoEndScale}, rewiredLogoShrinkDuration,
      {
        ease: FlxEase.expoOut,
        onComplete: function(_) {
          if (horseChance) return;

          FlxTween.tween(horsePNG, {x: rewiredLogoTargetX + offsetX}, rewiredLogoMoveDuration, {ease: FlxEase.quartInOut});
          FlxTween.tween(collabLogo, {alpha: 1}, collabLogoFadeInDuration, {startDelay: collabDelay});
          FlxTween.tween(cg5Logo, {alpha: 1}, cg5LogoFadeInDuration, {ease: FlxEase.expoOut, startDelay: cg5LogoAppearDelay});
          FlxTween.tween(cg5Logo, {x: cg5LogoEndX + offsetX}, cg5LogoMoveDuration, {ease: FlxEase.expoOut, startDelay: cg5LogoAppearDelay});

          var settleDuration:Float = 2.6;

          logoFallTimer = new FlxTimer().start(settleDuration + outroHoldDuration, function(_) {
            if (horsePNG != null)
            {
              FlxTween.cancelTweensOf(horsePNG);
              FlxTween.tween(horsePNG, {alpha: 0}, outroFallFadeDuration, {ease: FlxEase.sineOut});
            }
            if (collabLogo != null)
            {
              FlxTween.cancelTweensOf(collabLogo);
              FlxTween.tween(collabLogo, {alpha: 0}, outroFallFadeDuration, {ease: FlxEase.sineOut});
            }
            if (cg5Logo != null)
            {
              FlxTween.cancelTweensOf(cg5Logo);
              FlxTween.tween(cg5Logo, {alpha: 0}, outroFallFadeDuration, {ease: FlxEase.sineOut});
            }
          });
        }
      });

    outroTimer = new FlxTimer().start(outroTotalDuration, function(_) {
      PlayState.instance.endSong();
    });
  }

  override function onDestroy(event)
  {
    super.onDestroy(event);
    this.hasHiddenStrums = false;
    this.hasDoneOutro = false;
    this.curBeat = 0;
    this.isPauseCreditHooked = false;

    if (outroTimer != null)
    {
      outroTimer.cancel();
      outroTimer = null;
    }

    if (logoFallTimer != null)
    {
      logoFallTimer.cancel();
      logoFallTimer = null;
    }
  }
}
