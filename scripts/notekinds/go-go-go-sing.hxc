package rewired.notekinds;

import funkin.play.notes.notekind.NoteKind;
import funkin.play.PlayState;
import funkin.play.character.CharacterType;

class GoGoGoNoteKind extends NoteKind
{
  // 0 - no
  // 1 - normal
  // 2 - alt
  // 3 - alt2
  var goParams:Dynamic = [
    {
      name: "cg5Sing",
      description: "Cg5 Sings",
      type: "Int",
      data: {
        min: 0,
        max: 3,
        step: 1,
        precision: 1,
        defaultValue: 1
      }
    },
    {
      name: "ironSing",
      description: "Ironmouse Sings",
      type: "Int",
      data: {
        min: 0,
        max: 3,
        step: 1,
        precision: 1,
        defaultValue: 1
      }
    },
    {
      name: "qtSing",
      description: "QT Sings",
      type: "Int",
      data: {
        min: 0,
        max: 3,
        step: 1,
        precision: 1,
        defaultValue: 1
      }
    }
  ];

  public function new()
  {
    super('qt-go-go-go-note', 'Go Go Go Character Sings', 'funkin', goParams, true);
  }

  override public function onNoteHit(ev)
  {
    processNoteSings(ev.note, false, ev.note.noteData.getMustHitNote());
  }

  override public function onNoteMiss(ev)
  {
    if (ev.note.noteData.getMustHitNote())
    {
      processNoteSings(ev.note, true, true);
    }
  }

  override public function onNoteHoldDrop(ev)
  {
  }

  function processNoteSings(note, miss:Bool, isPlayer:Bool):Void
  {
    final cg5Sing:Int = getSingParam(note, "cg5Sing");
    final ironSing:Int = getSingParam(note, "ironSing");
    final qtSing:Int = getSingParam(note, "qtSing");

    processCharacter(cg5, cg5Sing, note, miss, isPlayer);
    processCharacter(irmouse, ironSing, note, miss, isPlayer);
    processCharacter(qt, qtSing, note, miss, isPlayer);
  }

  function processCharacter(char:Dynamic, singType:Int, note:Dynamic, miss:Bool, isPlayer:Bool):Void
  {
    if (char == null)
      return;

    if (singType <= 0)
    {
      //On both hit and miss, a character with 0
      //must stop being hooked
      if (isPlayer)
        unHookChar(char);

      return;
    }

    hookChar(char, miss, note, singType, isPlayer);
  }

  function getSingParam(note:Dynamic, name:String):Int
  {
    final value:Dynamic = note.getParam(name);

    if (value == null)
      return 0;

    return Std.int(value);
  }

  var cg5(get, never):Dynamic;
  function get_cg5():Dynamic
  {
    return PlayState.instance.currentStage.getDad();
  }

  var irmouse(get, never):Dynamic;
  function get_irmouse():Dynamic
  {
    return PlayState.instance.currentStage.getGirlfriend();
  }

  var qt(get, never):Dynamic;
  function get_qt():Dynamic
  {
    return PlayState.instance.currentStage.getBoyfriend();
  }

  function hookChar(char:Dynamic, miss:Bool, note:Dynamic, singType:Int, doPlayer:Bool = true):Void
  {
    char.characterType = doPlayer ? CharacterType.BF : CharacterType.DAD;

    var suffixShit:String = "";

    if (!miss)
    {
      /*switch (singType)
      {
        case 2:
          suffix = "alt";

        case 3:
          suffix = "alt2";

        default:
          suffix = "";
      }*/ //:rolling_eyes:

      if (singType == 2)
        suffixShit = "alt";

      if (singType == 3)
        suffixShit = "alt2";
    }
    char.playSingAnimation(note.noteData.getDirection(), miss, suffixShit);
    char.holdTimer = 0;
  }

  function unHookChar(char:Dynamic):Void
  {
    if (char == null)
      return;

    char.characterType = CharacterType.DAD;
  }
}